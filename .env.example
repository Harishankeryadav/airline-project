# Copy to .env and change for anything beyond local development.
MYSQL_ROOT_PASSWORD=root
DB_USERNAME=airline
DB_PASSWORD=airline
DB_HOST=localhost
DB_PORT=3306
REDIS_HOST=localhost
REDIS_PORT=6379

# --- auth-service / security (shared contract: gateway + every service that verifies tokens use the SAME secret)
# Must be at least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRATION_MINUTES=60
# Creates (or promotes) this account as ADMIN at auth-service startup. Leave empty to skip.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- service discovery
EUREKA_URL=http://localhost:8761/eureka
EUREKA_ENABLED=true

# --- booking-service
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Leave empty to find flights-service through Eureka; set to http://localhost:8081 to bypass the registry.
FLIGHTS_URL=

# --- reminder-service (email). Defaults send to Mailpit from docker-compose: http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=noreply@airline.local
REMINDER_LEAD_HOURS=24

# --- api-gateway
# Browser origins allowed to call the gateway (comma separated) - add your deployed frontend URL here.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_SECOND=20
RATE_LIMIT_BURST=40
RATE_LIMIT_LOGIN_PER_SECOND=1
RATE_LIMIT_LOGIN_BURST=10

# --- docker compose --profile app (everything in containers)
# The address the BROWSER uses to reach the gateway (baked into the web app at build time).
PUBLIC_API_URL=http://localhost:8080
VITE_CURRENCY=INR
